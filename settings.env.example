# Copy to .env in the directory where you run Weather Lab. Never upload .env.
OPENAI_API_KEY=
WEATHERLAB_ENABLE_CLOUD=0
# Default 0 means no paid calls. Set a personally approved daily ceiling before enabling.
WEATHERLAB_DAILY_API_BUDGET_USD=0
WEATHERLAB_MODEL_SMALL=gpt-5.6-luna
WEATHERLAB_MODEL_MEDIUM=gpt-5.6-terra
WEATHERLAB_MODEL_LARGE=gpt-5.6-sol
# Input,output USD per million tokens: verified 2026-09-15; recheck official pricing before enabling.
WEATHERLAB_PRICE_SMALL=0.20,1.20
WEATHERLAB_PRICE_MEDIUM=2,12
WEATHERLAB_PRICE_LARGE=4,20

# Optional read-only Polymarket US account connection (never required for public paper runs).
# Leave blank to reuse the existing local Windows-encrypted SupahTrade credential file.
WEATHERLAB_POLYMARKET_KEY_ID=
WEATHERLAB_POLYMARKET_SECRET_KEY=
# Optional absolute path to your existing Windows DPAPI credential file.
WEATHERLAB_POLYMARKET_DPAPI_PATH=

# Optional Apple WeatherKit developer JWT. Keep local; expired tokens fail closed.
# Manual iPhone forecast entry works without this. See docs/APPLE-NWS-STUDY.md.
WEATHERLAB_WEATHERKIT_TOKEN=
# Or leave TOKEN blank and use these for automatic local 20-minute ES256 tokens.
# Requires Node.js built-in crypto only; no npm installation.
WEATHERLAB_WEATHERKIT_TEAM_ID=
WEATHERLAB_WEATHERKIT_KEY_ID=
WEATHERLAB_WEATHERKIT_SERVICE_ID=
WEATHERLAB_WEATHERKIT_KEY_PATH=
